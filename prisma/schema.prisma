generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique @db.VarChar(100)
  valor String
}

model pedido_items {
  id              Int      @id @default(autoincrement())
  pedido_id       Int?
  dish_id         String   @db.VarChar(50)
  nombre          String   @db.VarChar(150)
  categoria       String?  @db.VarChar(50)
  porcion         String?  @db.VarChar(50)
  opcion          String?  @db.VarChar(100)
  precio_unitario Decimal  @db.Decimal(10, 2)
  cantidad        Int      @default(1)
  subtotal        Decimal  @db.Decimal(10, 2)
  notas           String?
  pedidos         pedidos? @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pedido_id], map: "idx_pedido_items_pedido_id")
}

model pedidos {
  id                       Int            @id @default(autoincrement())
  numero_pedido            String         @unique @db.VarChar(20)
  cliente_nombre           String         @db.VarChar(150)
  cliente_telefono         String         @db.VarChar(50)
  cliente_email            String?        @db.VarChar(150)
  tipo_entrega             String?        @default("recogida_local") @db.VarChar(50)
  direccion_entrega        String?
  direccion_detalles       String?        @db.VarChar(255)
  codigo_postal            String?        @db.VarChar(10)
  repartidor_id            String?        @db.VarChar(50)
  repartidor_nombre        String?        @db.VarChar(100)
  fecha_salida_reparto     DateTime?      @db.Timestamptz(6)
  fecha_entregado          DateTime?      @db.Timestamptz(6)
  tiempo_entrega_minutos   Int?
  hora_recogida            String?        @db.VarChar(50)
  notas                    String?
  metodo_pago              String         @db.VarChar(50)
  estado_pago              String         @default("pendiente") @db.VarChar(50)
  estado_pedido            String         @default("recibido") @db.VarChar(50)
  total                    Decimal        @db.Decimal(10, 2)
  stripe_session_id        String?        @db.VarChar(255)
  stripe_payment_intent_id String?        @db.VarChar(255)
  created_at               DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?      @default(now()) @db.Timestamptz(6)
  pedido_items             pedido_items[]

  @@index([created_at(sort: Desc)], map: "idx_pedidos_created_at")
  @@index([estado_pedido], map: "idx_pedidos_estado")
  @@index([estado_pago], map: "idx_pedidos_estado_pago")
}

model Reserva {
  id          Int      @id @default(autoincrement())
  nombre      String
  email       String
  telefono    String?
  fecha       DateTime
  personas    Int
  mensaje     String?
  estado      String   @default("confirmada")
  createdAt   DateTime @default(now())
  seccion     String   @default("obento")
  cancelToken String?  @unique @default(uuid())
  lang        String   @default("es")
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  categoria   String
  sub         String?
  alergenos   String?
  imagen      String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  concepto    String   @default("obento")
  nombreEn    String?
  destacado   Boolean  @default(false)
}

model Imagen {
  id        Int      @id @default(autoincrement())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model GaleriaFoto {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  label     String?
}

model Review {
  id        Int      @id @default(autoincrement())
  nombre    String
  texto     String
  rating    Int      @default(5)
  origen    String?
  aprobado  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Visita {
  id        Int      @id @default(autoincrement())
  pagina    String
  referrer  String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id            Int      @id @default(autoincrement())
  sessionId     String   @db.VarChar(100)
  tipo          String   @db.VarChar(50) // page_view, add_to_cart, cart_view, checkout_open, order_completed
  pagina        String?  @db.VarChar(255)
  dishId        String?  @db.VarChar(50)
  dishNombre    String?  @db.VarChar(150)
  cantidadItems Int?     @default(0)
  totalCarrito  Decimal? @db.Decimal(10, 2)
  metadata      String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([tipo, createdAt(sort: Desc)], map: "idx_analytics_tipo_date")
  @@index([sessionId], map: "idx_analytics_session")
}

model ReservaServicio {
  id          Int      @id @default(autoincrement())
  nombre      String
  email       String
  telefono    String?
  servicio    String
  fecha       DateTime
  personas    Int
  mensaje     String?
  empresa     String?
  menu        String?
  estado      String   @default("pendiente")
  cancelToken String?  @unique @default(uuid())
  createdAt   DateTime @default(now())
}

model Cupon {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  descripcion String?
  descuento   Float
  tipo        String   @default("porcentaje")
  minimo      Float?
  activo      Boolean  @default(true)
  usos        Int      @default(0)
  maxUsos     Int?
  createdAt   DateTime @default(now())
}

model Oferta {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  descuento   Float?
  tipo        String   @default("porcentaje")
  badge       String?  @default("PROMO")
  validoHasta String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Cliente {
  id             Int       @id @default(autoincrement())
  clientKey      String    @unique
  nombre         String
  email          String?
  telefono       String?
  primeraReserva DateTime?
  ultimaReserva  DateTime?
  totalReservas  Int       @default(0)
  totalPedidos   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ClienteTag {
  id        Int      @id @default(autoincrement())
  clientKey String
  tag       String
  createdAt DateTime @default(now())

  @@unique([clientKey, tag])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?
  password  String
  rol       String   @default("general")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==========================================
// MÓDULO DE ALMACÉN, FACTURAS, MERMAS Y COSTES
// ==========================================

model StockItem {
  id               Int                @id @default(autoincrement())
  nombre           String             @db.VarChar(150)
  categoria        String             @default("Pescados y Mariscos") @db.VarChar(100) // Pescados, Carnes, Verduras, Arroz y Granos, Nori y Algas, Packaging, Salsas y Condimentos, Bebidas, Limpieza, Otros
  unidad           String             @default("kg") @db.VarChar(20) // kg, g, l, ml, unidad, caja, paquete
  cantidadActual   Float              @default(0)
  stockMinimo      Float              @default(5)
  costeUnitario    Float              @default(0) // Precio medio ponderado actual (€/unidad)
  ultimoCoste      Float              @default(0) // Último precio pagado según última factura
  proveedorHabitual String?           @db.VarChar(150)
  notas            String?
  activo           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  facturaItems     FacturaItem[]
  movimientos      StockMovimiento[]
  mermaItems       MermaItem[]
  escandalloItems  EscandalloIngrediente[]

  @@index([categoria], map: "idx_stock_categoria")
  @@index([activo], map: "idx_stock_activo")
}

model Factura {
  id              Int           @id @default(autoincrement())
  numeroFactura   String        @db.VarChar(100)
  proveedor       String        @db.VarChar(150)
  cifProveedor    String?       @db.VarChar(50)
  fechaEmision    DateTime      @db.Date
  fechaRegistro   DateTime      @default(now())
  totalBase       Float         @default(0)
  totalIva        Float         @default(0)
  totalFactura    Float         @default(0)
  estadoPago      String        @default("pagado") @db.VarChar(50) // pagado, pendiente
  metodoPago      String?       @default("transferencia") @db.VarChar(50)
  archivoUrl      String?       @db.VarChar(255)
  archivoNombre   String?       @db.VarChar(255)
  notas           String?
  items           FacturaItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([fechaEmision(sort: Desc)], map: "idx_factura_fecha")
  @@index([proveedor], map: "idx_factura_proveedor")
}

model FacturaItem {
  id              Int        @id @default(autoincrement())
  facturaId       Int
  stockItemId     Int?
  descripcion     String     @db.VarChar(200)
  categoria       String?    @db.VarChar(100)
  cantidad        Float      @default(1)
  unidad          String     @default("kg") @db.VarChar(20)
  precioUnitario  Float      @default(0)
  ivaPct          Float      @default(10) // 10% comida, 21% general/bebidas, 4% básico
  subtotal        Float      @default(0)
  factura         Factura    @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  stockItem       StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@index([facturaId], map: "idx_factura_item_factura")
  @@index([stockItemId], map: "idx_factura_item_stock")
}

model MermaItem {
  id              Int        @id @default(autoincrement())
  stockItemId     Int
  cantidad        Float
  unidad          String     @db.VarChar(20)
  motivo          String     @db.VarChar(100) // caducado, podrido, error_cocina, merma_limpieza, roto_transporte, otro
  costePerdido    Float      @default(0) // Calculado automáticamente: cantidad * costeUnitario
  notas           String?
  registradoPor   String?    @db.VarChar(100)
  fecha           DateTime   @default(now())
  stockItem       StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([fecha(sort: Desc)], map: "idx_merma_fecha")
  @@index([stockItemId], map: "idx_merma_stock")
}

model StockMovimiento {
  id              Int        @id @default(autoincrement())
  stockItemId     Int
  tipo            String     @db.VarChar(50) // entrada_factura, salida_venta, merma, ajuste_manual
  cantidad        Float      // Positivo (entra) o Negativo (sale)
  stockPrevio     Float
  stockPosterior  Float
  costeUnitario   Float      @default(0)
  referencia      String?    @db.VarChar(150) // ej: "Factura F-2026-081" o "Pedido #OB-1024"
  notas           String?
  fecha           DateTime   @default(now())
  stockItem       StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId, fecha(sort: Desc)], map: "idx_movimiento_stock_date")
}

// Escandallos: Recetas y relación plato -> ingredientes del almacén
model EscandalloIngrediente {
  id              Int        @id @default(autoincrement())
  menuItemId      Int?       // Relacionado con MenuItem de la carta
  dishId          String?    @db.VarChar(100) // Por si coincide con el dish_id del pedido
  platoNombre     String     @db.VarChar(150)
  stockItemId     Int
  cantidad        Float      // Cantidad que consume un plato (ej: 0.080 para 80 gramos de salmón)
  unidad          String     @default("kg") @db.VarChar(20)
  notas           String?
  stockItem       StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId], map: "idx_escandallo_menu_item")
  @@index([stockItemId], map: "idx_escandallo_stock_item")
}
